<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <!-- Numéro de version de l'application (A propos, propriétés de l'exe) : à changer à chaque version publiée ;
         la publication (tag vX.YY) vérifie qu'il correspond au tag -->
    <Version>1.20</Version>
    <Product>BrunoGUI GenII</Product>
    <Authors>Bruno COURTOIS</Authors>
    <Copyright>Copyright © 2026 Bruno COURTOIS</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Types de référence nullables dans tout le projet : une valeur qui peut manquer est déclarée (string?), le compilateur
         signale tout usage qui pourrait lever une NullReferenceException -->
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Resources\FichierrOuvrir.bmp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fichiers partiels du formulaire principal (découpé par sujet) : rangés sous EchiquierPrincipal.cs dans Visual Studio,
         et ouverts comme du code (pas dans le concepteur de formulaires) -->
    <Compile Update="EchiquierPrincipal.Moteur.cs;EchiquierPrincipal.Pendule.cs;EchiquierPrincipal.Parcours.cs;EchiquierPrincipal.Fichiers.cs;EchiquierPrincipal.AnalysePartie.cs">
      <DependentUpon>EchiquierPrincipal.cs</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- Le projet de tests a son propre .csproj : on l'exclut de l'application -->
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- PreserveNewest : un Stockfish mis à jour par l'application dans bin n'est pas écrasé à chaque compilation -->
    <Content Include="stockfish\stockfish.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Krypton.Navigator" Version="95.25.10.293" />
    <PackageReference Include="Krypton.Ribbon" Version="95.25.10.293" />
    <PackageReference Include="Krypton.Toolkit" Version="95.25.10.293" />
    <PackageReference Include="Krypton.Workspace" Version="95.25.10.293" />
  </ItemGroup>
  <ItemGroup>
    <!-- Traductions de l'interface (voir Langue.cs) : à côté de l'exécutable, modifiables sans recompiler -->
    <!-- Aide (pages HTML et captures d'écran, une page par langue), ouverte dans le navigateur par le menu Aide -->
    <None Update="Aide\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Langues\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
